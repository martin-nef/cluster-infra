PUBLIC_URL=https://ops.nefcloud.top
# Comma-separated. Keep in sync with oauth2-proxy's allowed_emails.txt.
ALLOWED_APPROVERS=martin.nefjodov@gmail.com
# An unanswered request expires after this many seconds, unless it asks for
# longer (spec.ttlSeconds), up to MAX_TTL.
REQUEST_TTL=900
MAX_TTL=43200
# Pending slots of their own, per requester (API server username): user=n,...
# Requesters not named here share MAX_PENDING. More are rejected unannounced.
PENDING_CAPS=system:serviceaccount:claude-remote:claude-remote=3
MAX_PENDING=3
# During these hours a request that will still be waiting when they end isn't
# announced; one digest lists them when they end. Empty: never quiet.
QUIET_HOURS=22:00-07:00
QUIET_TZ=Europe/London
# Finished requests (the audit trail) are deleted after this many days.
RETENTION_DAYS=90
# Rejected and Expired requests decided nothing; they go sooner, so junk can't
# fill the namespace's quota for long.
SHORT_RETENTION_DAYS=7
# The GitHub verbs act on this account's repos, with an App of this name that
# the broker creates from https://ops.nefcloud.top/github.
GITHUB_OWNER=martin-nef
GITHUB_APP_NAME=martin-nef-ops
