# Release name stays tailscale-release: renaming it would make Flux uninstall
# the running operator and install a new one.
#
# No --version: the operator floats to the latest chart so it auto-updates (see
# commit 59a48c1). Keep it unpinned here, otherwise flux-helm.sh regenerates a
# version pin into helmrelease.yaml and reverses the auto-update.
helm repo add tailscale https://pkgs.tailscale.com/helmcharts
helm repo update
helm upgrade \
  --install \
  tailscale-release \
  tailscale/tailscale-operator \
  --namespace=tailscale \
  --create-namespace \
  --wait
